            "type": "INT UNSIGNED",
            "initial_value": 200,
            "range": {
                "min": 2,
                "max": 2000,
                "step": 2
            },
            "disabled_when": {
                "exposure_mode": {
                    "operator": "!=",
                    "value": "off"
                },
                "use_variable_framerate": {
                    "operator": "==",
                    "value": "0"
                }
            }
        },
        "iso": {
            "group": "brightness",
            "name": "iso",
            "type": "INT UNSIGNED",
            "initial_value": 800,
            "range": {
                "min": 100,
                "max": 800,
                "step": 10
            },
            "disabled_when": {
                "exposure_mode": {
