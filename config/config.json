                "max": 24,
                "step": 0.2
            },
            "disabled_when": {
                "exposure_mode": {
                    "operator": "!=",
                    "value": "off"
                },
                "use_variable_framerate": {
                    "operator": "==",
                    "value": "0"
                }
            }
        },
        "exposure_time": {
            "group": "brightness",
